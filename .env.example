# ScoreStack — Environment Variables
# Copy this file to .env.local for local development.
# All variables marked REQUIRED must be set before the app will start correctly.

# =============================================================================
# DATABASE
# =============================================================================

# REQUIRED — PostgreSQL connection string via Supabase pooler (used at runtime).
DATABASE_URL=postgresql://user:password@host:5432/scorestack

# Fallback checked by prisma.ts if DATABASE_URL is absent (Vercel Postgres sets this)
# POSTGRES_URL=


# =============================================================================
# AUTH — NextAuth v5
# =============================================================================

# REQUIRED — Random 32-byte secret used to sign session tokens.
# Generate: openssl rand -hex 32
AUTH_SECRET=

# REQUIRED — Canonical HTTPS URL of the deployed app. Must not have a trailing slash.
# Vercel sets VERCEL_URL automatically; override with your custom domain.
NEXTAUTH_URL=https://app.scorestack.io


# =============================================================================
# EMAIL — Resend
# =============================================================================

# REQUIRED — Resend API key for magic-link auth emails and enrichment notifications.
RESEND_API_KEY=

# REQUIRED — Verified sender address. Must match a domain verified in Resend.
RESEND_FROM_EMAIL=noreply@scorestack.io


# =============================================================================
# FILE STORAGE — Vercel Blob
# =============================================================================

# REQUIRED — Read/write token for Vercel Blob (used to store uploaded CSVs).
# In Vercel project settings this is provisioned automatically as BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Fallback token name (checked if BLOB_READ_WRITE_TOKEN is absent)
# VERCEL_BLOB_TOKEN=


# =============================================================================
# AI — Anthropic Claude
# =============================================================================

# REQUIRED — Anthropic API key for AI message generation (claude-haiku-4-5).
ANTHROPIC_API_KEY=

# Set to "false" to disable all Anthropic calls (useful in dev without a key).
# ANTHROPIC_ENABLED=true


# =============================================================================
# BILLING — Lemon Squeezy
# =============================================================================

# REQUIRED — Lemon Squeezy API key (Settings → API).
LEMONSQUEEZY_API_KEY=

# REQUIRED — Webhook signing secret. Set when registering the webhook endpoint.
LEMONSQUEEZY_WEBHOOK_SECRET=

# REQUIRED — Your store ID (visible in the LS dashboard URL).
LEMONSQUEEZY_STORE_ID=

# REQUIRED — Product ID for the subscription plans product.
LEMONSQUEEZY_PLANS_PRODUCT_ID=

# REQUIRED — Product ID for the enrichment credits product.
LEMONSQUEEZY_CREDITS_PRODUCT_ID=

# REQUIRED (NEXT_PUBLIC) — Variant IDs for Starter and Pro plans.
# These are public because UpgradeModal reads them client-side via /api/billing/plans.
NEXT_PUBLIC_LEMONSQUEEZY_STARTER_VARIANT_ID=
NEXT_PUBLIC_LEMONSQUEEZY_PRO_VARIANT_ID=

# Set to "true" to expose the credit top-up UI on the billing page.
# ENABLE_CREDITS=true


# =============================================================================
# LINKEDIN ENRICHMENT — LinkedAPI
# =============================================================================

# REQUIRED — LinkedAPI authentication tokens for profile enrichment.
LINKED_API_TOKEN=
LINKED_API_ID_TOKEN=

# REQUIRED — Set to "true" to use real LinkedAPI calls. When false or unset,
# enrichment returns mock data instantly (useful in dev, must be true in prod).
LINKED_API_ENABLED=true

# Set to "true" to route enrichment through LinkedAPI (default path).
# When false, enrichment is skipped unless CONNECT_SAFELY_ENRICHMENT_ENABLED=true.
LINKED_API_ENRICHMENT_ENABLED=true


# =============================================================================
# LINKEDIN DELIVERY + ENRICHMENT — ConnectSafely
# =============================================================================

# REQUIRED for delivery — ConnectSafely REST API key.
CONNECT_SAFELY_API_KEY=

# Set to "true" to route message delivery through ConnectSafely (recommended).
CONNECT_SAFELY_DELIVERY_ENABLED=true

# Set to "true" to route profile enrichment through ConnectSafely instead of LinkedAPI.
# CONNECT_SAFELY_ENRICHMENT_ENABLED=false


# =============================================================================
# ENCRYPTION — BYOK Credential Storage
# =============================================================================

# REQUIRED for BYOK delivery feature — AES-256-GCM key for encrypting org API keys.
# Generate: openssl rand -hex 32
# WARNING: Rotating this key requires re-encrypting all stored credentials. See runbook.
ENCRYPTION_KEY=


# =============================================================================
# DELIVERY PACING
# =============================================================================

# Set to "true" to enable the teams/multi-member org feature.
# TEAMS_ENABLED=true

# Default delay between LinkedIn message sends (milliseconds). Default: 3000.
# DELIVERY_DELAY_MS=3000

# Provider-specific overrides (take precedence over DELIVERY_DELAY_MS).
# CONNECT_SAFELY_DELIVERY_DELAY_MS=3000
# LINKED_API_DELIVERY_DELAY_MS=3000


# =============================================================================
# TEST / DEVELOPMENT ONLY — do not set in production
# =============================================================================

# Set to "true" to skip real LinkedIn sends; logs instead.
# LINKED_API_TEST_DELIVERY=false
# LINKED_API_TEST_DELIVERY_PROFILE=https://www.linkedin.com/in/example

# Set to "true" to simulate a LinkedAPI limitExceeded error on every fetchProfile call.
# Use this to test the hard-stop abort path in EnrichmentProgress without hitting the real limit.
# LINKED_API_SIMULATE_LIMIT=false

# CONNECT_SAFELY_TEST_DELIVERY=false
# CONNECT_SAFELY_TEST_DELIVERY_PROFILE=https://www.linkedin.com/in/example
